  "segments": [
    {
      "start_ms": 0,
      "end_ms": 21560,
      "speaker": "teacher",
      "language": "en",
      "text": "Some surfaces fill a space. Others define it. Orchid Elegance by Al Amaar brings woven, tactile character into premium interiors — subtle in tone, rich in detail, and designed to be experienced up close."
    },
    {
      "start_ms": 21860,
      "end_ms": 57260,
      "speaker": "teacher",
      "language": "en",
      "text": "Built as premium HPL, it is scratch resistant, easy to clean, durable, fade resistant, and made for everyday interior use. Available in eight-by-four and ten-by-four sheet formats, with thickness options from zero-point-eight to one-point-two millimeters. For cabinetry, wall cladding, furniture, offices, retail, and hospitality, Orchid Elegance turns material into atmosphere. Al Amaar. Surfaces that shape the space."
    }
  ],
