<!doctype html>
<html lang="ar">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Introduce Yourself V4</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div id="stage"
    data-composition-id="lesson-01-introduce-yourself-v4-audio-lottie"
    data-start="0"
    data-duration="{{DURATION}}"
    data-fps="30"
    data-width="1920"
    data-height="1080">

    <div id="scene-01" class="clip scene s1" data-start="{{SCENE_01_START}}" data-duration="{{SCENE_01_DURATION}}" data-track-index="0">
      <div class="kicker">LESSON 01 · INTRODUCE YOURSELF</div>
      <div class="question en">Tell me about <strong>yourself.</strong></div>
      <div class="arabic hero-ar">مش فيلم وثائقي عن حياتك. <strong>أربع أو خمس جمل قصيرة تكفي.</strong></div>
      <div class="sentence-stack"><span>NAME</span><span>FROM</span><span>NOW</span><span>WORK</span><span>LIKE</span></div>
    </div>

    <div id="scene-02" class="clip scene s2" data-start="{{SCENE_02_START}}" data-duration="{{SCENE_02_DURATION}}" data-track-index="0">
      <div class="kicker">MODEL · MAYA + YOUR NAME</div>
      <div class="profile-card maya-card"><div class="avatar">M</div><div><b>MAYA</b><small>Jordan · Amman · designer · photography</small></div></div>
      <div class="model-lines">
        <div data-cue="maya.hello">Hi, <em>I'm Maya.</em></div>
        <div data-cue="maya.from">I'm from <em>Jordan.</em></div>
        <div data-cue="maya.live">I live in <em>Amman.</em></div>
        <div data-cue="maya.role">I'm a <em>designer.</em></div>
        <div data-cue="maya.like">I like <em>photography.</em></div>
      </div>
      <div class="name-note"><small>NAME PATTERN</small><strong class="en">I'm = I am</strong><p class="arabic">في الكلام الطبيعي، قلها كوحدة واحدة خفيفة.</p></div>
    </div>

    <div id="scene-03" class="clip scene s3" data-start="{{SCENE_03_START}}" data-duration="{{SCENE_03_DURATION}}" data-track-index="0">
      <div class="kicker">FROM = YOUR ORIGIN</div>
      <section class="meaning origin origin-main"><small>ORIGIN</small><h2>FROM</h2><p class="arabic">بلدك أو المكان اللي أنت أصلك منه</p><div class="place-chip">JORDAN</div><div class="place-chip alt">EGYPT</div><div class="place-chip">SAUDI ARABIA</div></section>
      <div class="origin-examples">
        <div data-cue="origin.jordan">I'm from <em>Jordan.</em></div>
        <div data-cue="origin.egypt">I'm from <em>Egypt.</em></div>
        <div data-cue="origin.saudi">I'm from <em>Saudi Arabia.</em></div>
      </div>
    </div>

    <div id="scene-04" class="clip scene s4" data-start="{{SCENE_04_START}}" data-duration="{{SCENE_04_DURATION}}" data-track-index="0">
      <div class="kicker">FROM ≠ LIVE IN</div>
      <div class="contrast-layout">
        <section class="meaning origin"><small>ORIGIN</small><h2>FROM</h2><p class="arabic">أصلك منين</p><div class="place-chip alt">EGYPT</div></section>
        <div class="route"><span></span><b>→</b><span></span></div>
        <section class="meaning now"><small>CURRENT HOME</small><h2>LIVE IN</h2><p class="arabic">عايش فين دلوقتي</p><div class="place-chip">AMMAN</div><div class="place-chip alt">DUBAI</div></section>
      </div>
      <div class="contrast-examples">
        <span data-cue="contrast.liveAmman">I live in Amman.</span>
        <span data-cue="contrast.fromEgypt">I'm from Egypt,</span>
        <span data-cue="contrast.liveDubai">but I live in Dubai.</span>
      </div>
    </div>

    <div id="scene-05" class="clip scene s5" data-start="{{SCENE_05_START}}" data-duration="{{SCENE_05_DURATION}}" data-track-index="0">
      <div class="kicker">PRONUNCIATION · LIVE</div>
      <div class="live-word en">LIVE</div>
      <div class="phoneme good" data-cue="pronunciation.correct">/lɪv/ <small>✓ verb · أعيش</small></div>
      <div class="phoneme bad" data-cue="pronunciation.wrong">/laɪv/ <small>live broadcast</small></div>
      <div class="pron-copy arabic">في جملتنا: الصوت قصير.</div>
      <div class="repeat-card en" data-cue="pronunciation.sentence">I <strong>live</strong> in Amman.</div>
    </div>

    <div id="scene-06" class="clip scene s6" data-start="{{SCENE_06_START}}" data-duration="{{SCENE_06_DURATION}}" data-track-index="0">
      <div class="kicker">YOUR ROLE · OPTIONAL</div>
      <div class="detail-columns roles-only">
        <section><small>ROLE</small><h2 class="en">I'm a…</h2><div class="detail-option" data-cue="role.designer"><i>◆</i> designer</div><div class="detail-option" data-cue="role.teacher"><i>▣</i> teacher</div></section>
        <section><small>MORE OPTIONS</small><h2 class="en">I'm…</h2><div class="detail-option" data-cue="role.engineer"><i>⌁</i> an engineer</div><div class="detail-option" data-cue="role.student"><i>●</i> a student</div></section>
      </div>
      <div class="arabic quiet-note">لو مش عايز تتكلم عن شغلك، الجملة دي اختيارية.</div>
    </div>

    <div id="scene-07" class="clip scene s7" data-start="{{SCENE_07_START}}" data-duration="{{SCENE_07_DURATION}}" data-track-index="0">
      <div class="kicker">ONE SMALL DETAIL · I LIKE…</div>
      <div class="detail-columns interests-only">
        <section><small>INTERESTS</small><h2 class="en">I like…</h2><div class="detail-option" data-cue="interest.photography"><i class="camera-mini"></i> photography</div><div class="detail-option" data-cue="interest.reading"><i>▤</i> reading</div></section>
        <section><small>MORE OPTIONS</small><h2 class="en">I like…</h2><div class="detail-option" data-cue="interest.football"><i>●</i> football</div><div class="detail-option" data-cue="interest.cooking"><i>⌁</i> cooking</div></section>
      </div>
      <div class="arabic quiet-note">التفصيلة الصغيرة تدي الشخص اللي قدامك موضوع يسألك عنه.</div>
    </div>

    <div id="scene-08" class="clip scene s8" data-start="{{SCENE_08_START}}" data-duration="{{SCENE_08_DURATION}}" data-track-index="0">
      <div class="kicker">SAME PATTERN · OMAR</div>
      <div class="omar-layout">
        <div class="model-lines compact">
          <div data-cue="omar.hello">Hi, <em>I'm Omar.</em></div>
          <div data-cue="omar.from">I'm from <em>Egypt.</em></div>
          <div data-cue="omar.live">I live in <em>Giza.</em></div>
          <div data-cue="omar.role">I'm a <em>student.</em></div>
          <div data-cue="omar.like">I like <em>football.</em></div>
          <div data-cue="omar.meet">Nice to <em>meet you.</em></div>
        </div>
        <div class="profile-card omar-card"><div class="avatar">O</div><div><b>OMAR</b><small>Egypt · Giza · student · football</small></div></div>
      </div>
    </div>

    <div id="scene-09" class="clip scene s9" data-start="{{SCENE_09_START}}" data-duration="{{SCENE_09_DURATION}}" data-track-index="0">
      <div class="kicker">READY FOR PRACTICE</div>
      <div class="final-copy"><small>REMEMBER THE PATTERN</small><h1>FOUR OR FIVE<br>SHORT SENTENCES</h1><p class="arabic">اسمك · بلدك · مكان سكنك أو شغلك · حاجة واحدة بتحبها</p><b class="say-now" data-cue="closing.seeYou">See you there!</b></div>
      <div class="summary-orbit"><span>NAME</span><span>FROM</span><span>NOW</span><span>WORK</span><span>LIKE</span></div>
      <div id="booksLottie" class="books-lottie" aria-hidden="true"></div>
    </div>

    <audio id="lesson-voiceover" data-start="0" data-duration="{{DURATION}}" data-track-index="50" data-volume="1" src="assets/audio/{{AUDIO_FILE}}"></audio>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js"></script>
  <script src="timing-data.js"></script>
  <script src="timeline.js"></script>
  <script>
    window.__timelines = window.__timelines || {};
    window.__timelines["lesson-01-introduce-yourself-v4-audio-lottie"] = window.__V4_TIMELINE__;
  </script>
</body>
</html>
